# Plantilla de variables de entorno para app-bfuture.
#
# Copia este archivo a `.env` (en la raiz del proyecto, junto a pyproject.toml)
# y rellena tus credenciales reales:
#
#     cp .env.example .env
#
# El archivo .env esta en .gitignore y NO debe subirse a git.
# NO lo pongas en src/assets/ : esa carpeta se empaqueta en el ejecutable
# al hacer `flet build` y filtraria las claves.

BINANCE_API_KEY=tu_api_key
BINANCE_API_SECRET=tu_api_secret

# Entorno: true = TESTNET (https://testnet.binancefuture.com, seguro para
# desarrollo), false = PRODUCCION real (https://fapi.binance.com).
# Las claves de testnet se generan en https://testnet.binancefuture.com y son
# DISTINTAS de las de produccion.
BINANCE_TESTNET=true

# (Opcional) Claves de PRODUCCION SOLO para el analizador read-only
# (binance.analyzeprod). La app NO opera con estas. Ideal: key de solo lectura.
# BINANCE_PROD_API_KEY=...
# BINANCE_PROD_API_SECRET=...

# --- Ajustes opcionales del scalp / riesgo (tienen valores por defecto) ---
DEFAULT_LEVERAGE=5                 # apalancamiento por defecto al abrir
RISK_MAX_LEVERAGE=10              # tope de apalancamiento (guarda)
ENTRY_TP_PCT=1                    # take-profit por defecto (%)
ENTRY_STOP_PCT=2                 # stop-loss por defecto (%)
SCALP_MAX_HOLD_MIN=5             # cierre por tiempo del scalp (minutos)
RISK_MAX_ORDER_NOTIONAL=1000      # tamano max por orden (USDT)
RISK_MAX_POSITION_NOTIONAL=5000   # exposicion max por simbolo (USDT)
RISK_MAX_OPEN_POSITIONS=5         # nro max de posiciones simultaneas
RISK_DAILY_LOSS_LIMIT=100         # kill-switch: perdida diaria max (USDT)

# --- Modo Auto (el bot elige simbolo y calcula TP/SL/cantidad) ---
AUTO_TARGET_ROE=0.35      # objetivo de ganancia (ROE sobre el margen)
AUTO_STOP_ROE=0.5         # perdida maxima (fraccion del margen)
AUTO_MARGIN=0.30          # capital por orden en modo Auto (USDT)
AUTO_MAX_PRICE=0.5        # solo monedas con precio <= este valor
AUTO_MIN_VOL=1000000      # liquidez minima 24h para elegir candidata
TRAIL_PCT=0.005           # distancia del trailing stop (0.5%)
